#include <bits/stdc++.h>
using namespace std;
int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    int t;
    cin >> t;
    while (t--) {
        long long n, x, y, z;
        cin >> n >> x >> y >> z;
        // Option 1: no AI
        long long t1 = (n + x + y - 1) / (x + y);
        // Option 2: use AI
        long long t2;
        long long before = z * x;
        if (before >= n) {
            t2 = (n + x - 1) / x; // finishes during setup
        } else {
            long long rem = n - before;
            t2 = z + (rem + (x + 10 * y) - 1) / (x + 10 * y);
        }
        cout << min(t1, t2) << "\n";
    }
    return 0;
}
